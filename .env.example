# =============================================================================
# AI Resume Analyzer & Job Matcher — Environment configuration (EXAMPLE)
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#   cp .env.example .env
# Every setting below has a sensible default, so the app runs even if you
# leave this file empty — the LLM features just fall back to templates.
# =============================================================================

# ---- Server ----
# Comma-separated list of origins allowed to call the API (the frontend URL).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- File upload limits ----
# Max resume size in megabytes. Uploads larger than this are rejected.
MAX_UPLOAD_MB=5

# ---- Semantic engine ----
# "auto"  -> use transformer embeddings if installed, else TF-IDF (recommended)
# "tfidf" -> force the lightweight TF-IDF backend (no torch needed)
# "embeddings" -> force sentence-transformers (requires requirements-ml.txt)
SEMANTIC_BACKEND=auto
# Sentence-transformers model used when the embeddings backend is active.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---- Persistence (optional) ----
# When true, each analysis is stored so you can list past analyses.
ENABLE_HISTORY=true
# SQLite by default (zero setup). For Postgres use e.g.:
#   postgresql+psycopg://user:pass@localhost:5432/resume_matcher
DATABASE_URL=sqlite:///./resume_matcher.sqlite3

# ---- LLM layer (OPTIONAL) ----
# Leave LLM_PROVIDER blank to run fully offline with template-based
# recommendations / interview questions. Set it to enable LLM generation.
# Supported: "openai", "anthropic", or "" (disabled).
LLM_PROVIDER=
# Model name for the chosen provider, e.g.:
#   openai    -> gpt-4o-mini
#   anthropic -> claude-3-5-haiku-latest
LLM_MODEL=
# API key for the chosen provider. Keep this secret.
LLM_API_KEY=
# Max seconds to wait for an LLM response before falling back to templates.
LLM_TIMEOUT_SECONDS=30
